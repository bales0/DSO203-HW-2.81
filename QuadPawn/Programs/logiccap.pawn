#include <fpga>
#include <console>

#define FPGA_IMAGE "LOGIC.FPG"

/// Select FPGA data/count/identity using the original board control pins.
/// PC5 (H/L) selects count and PC4 (ClrR) selects image identity. This avoids
/// relying on the unverified parallel-write path of the original iCE65 design.
fpga_set_config(value)
{
    new fpgapin: selection = NO_PINS;
    if (value & 0x0001) selection |= PC5;
    if (value & 0x0020) selection |= PC4;
    fpga_write_pins(selection, PC4 | PC5);
}

fpga_reset()
{
    // PB1 is our reset pin, toggle it low to reset the FPGA
    fpga_config_outputs(PB1 | PC4 | PC5);
    fpga_set_config(0);
    fpga_clear_pin(PB1);
    delay_ms(1);
    fpga_set_pin(PB1);
    delay_ms(1);
}

bool: fpga_initialize()
{
    while (!f_exists(FPGA_IMAGE))
    {
        if (show_dialog("Please copy " ... FPGA_IMAGE ... " to the USB drive.",
            "OK", "", "", "Exit") == 3)
        {
            return false;
        }
    }

    if (!fpga_load(FPGA_IMAGE))
    {
        show_msgbox("Failed to load " ... FPGA_IMAGE ... " to the FPGA!");
        return false;
    }
    
    // Configure FPGA clock at 72 MHz
    wavein_samplerate(72000000);
    
    // Capture logic for channels A & B expects 200mV range.
    config_chA(ADC_DC, ADC_200mV, .offset = 0);
    config_chB(ADC_DC, ADC_200mV, .offset = 0);
    
    fpga_reset();

    // The HX4K image exposes an identity register; reading it never pops FIFO.
    // Allow the external clock/reset and configuration path to settle. Check
    // two bus transfers, with bounded retries, instead of blaming the image
    // on the strength of one failed hardware read.
    new identity[2];
    new bool: identified = false;
    for (new attempt = 0; attempt < 3; attempt++)
    {
        fpga_set_config(0x0020);
        delay_ms(1);
        fpga_read(identity);
        if (identity[0] == 0x4C43 && identity[1] == 0x4C43)
        {
            identified = true;
            break;
        }
    }
    fpga_set_config(0x0000);
    if (!identified)
    {
        show_msgbox(strjoin("FPGA bus check failed\nID 0x", hex(identity[0]),
            " / 0x", hex(identity[1]), "\nExpected 0x4C43, HW 2.81"));
        return false;
    }
    
    return true;
}

bool: write_sample(File: file, timestamp_high, timestamp_low, levels)
{
    // Line format is:
    // #0000000000000 0A 0B 0C 0D
    new valbuf{16};
    new line{64} = "#";
    
    // Write the timestamp in two parts because Pawn can't process
    // 64 bit integers.
    valstr(valbuf, timestamp_high);
    strcat(line, valbuf);
    
    valstr(valbuf, timestamp_low, .minlength = 9);
    strcat(line, valbuf);
    
    // Write the channels
    strcat(line, " ");
    strcat(line, (levels & 1) ? "1A " : "0A ");
    strcat(line, (levels & 2) ? "1B " : "0B ");
    strcat(line, (levels & 4) ? "1C " : "0C ");
    strcat(line, (levels & 8) ? "1D " : "0D ");
    strcat(line, "\r\n");
    return f_write(file, line);
}

new recv_buffer[4096];

bool: do_capture()
{
    println("");
    println("Starting new capture");
    
    new filename{14} = "WAVES%03d.VCD";
    if (!select_filename(filename))
    {
        println("No free VCD filename or disk error.");
        return false;
    }
    
    println(strjoin("Writing to ", filename));
    
    new File: file = f_open(filename, FA_WRITE | FA_CREATE_NEW);
    if (!file)
    {
        println("Cannot create VCD file.");
        return false;
    }
    if (!f_write(file,
        "$version DSO Quad Logic Capture $end\r\n" ...
        "$timescale 1ns $end\r\n" ...
        "$scope module logic $end\r\n" ...
        "$var wire 1 A ChannelA $end\r\n" ...
        "$var wire 1 B ChannelB $end\r\n" ...
        "$var wire 1 C ChannelC $end\r\n" ...
        "$var wire 1 D ChannelD $end\r\n" ...
        "$upscope $end\r\n" ...
        "$enddefinitions $end\r\n" ...
        "$dumpvars 0A 0B 0C 0D $end\r\n"
    ))
    {
        f_close(file);
        println("File writing failed.");
        return false;
    }
    
    fpga_reset();
    
    // Main data processing loop
    new timestamp_high = 0, timestamp_low = 0;
    new phase = 0; // Fractional 72 MHz ticks; nine ticks are exactly 125 ns.
    new samples = 0;
    new prev_levels = 0;
    new bool: overrun = false;
    new bool: write_ok = true, bool: capture_ok = true;
    while (!peek_keys(ANY_KEY))
    {
        // First read the amount of available data
        fpga_set_config(0x0001);
        fpga_read(recv_buffer, 1);
        new count = recv_buffer[0];
        if (count & 0x8000)
        {
            overrun = true;
            break; // FPGA remembers saturation even after FIFO was drained.
        }
        
        // Wait for data
        if (count == 0)
            continue;
        
        if (count < 0 || count > 4095)
        {
            capture_ok = false;
            break;
        }
        if (count == 4095)
        {
            overrun = true;
            break; // Lost transitions cannot be assigned reliable timestamps.
        }
        
        // Don't read more than what fits in our buffer
        if (count > sizeof recv_buffer)
            count = sizeof recv_buffer;
        
        // Get the data into our buffer
        fpga_set_config(0x0000);
        fpga_read(recv_buffer, count);
        
        // Then process the data
        // If top bit is 0 then value is: 0xTTTL
        //   where TTT is the time from previous event
        //   and L is the new input levels.
        // If top bit is 1 then value is: 0xTTTT
        //   where TTTT is time / 2048.
        for (new i = 0; i < count; i++)
        {
            new levels = prev_levels;
            new ticks;
            if (recv_buffer[i] & 0x8000)
            {
                ticks = (recv_buffer[i] & 0x7FFF) * 2048;
            }
            else
            {
                ticks = (recv_buffer[i] >> 4) + 1;
                levels = recv_buffer[i] & 0x0F;
            }
            
            // Keep integer nanoseconds plus the fractional phase. This avoids
            // 32-bit multiplication overflow and accumulating rounding error.
            new remainder = phase + ticks % 9;
            timestamp_low += (ticks / 9) * 125 + (remainder * 125) / 9 - (phase * 125) / 9;
            phase = remainder % 9;
            if (timestamp_low >= 1000000000)
            {
                timestamp_high += 1;
                timestamp_low -= 1000000000;
            }
            
            if (levels != prev_levels)
            {
                samples += 1;
                prev_levels = levels;
                
                if (!write_sample(file, timestamp_high, timestamp_low, levels))
                {
                    write_ok = false;
                    break;
                }
            }
        }
        if (!write_ok) break;
    }
    
    if (overrun)
        write_ok = f_write(file, "$comment Capture stopped: FPGA FIFO full; data may be incomplete $end\r\n");
    else if (!capture_ok)
        write_ok = f_write(file, "$comment Capture stopped: invalid FPGA data count $end\r\n");
    else if (write_ok)
    {
        samples += 1;
        write_ok = write_sample(file, timestamp_high, timestamp_low, prev_levels);
    }
    new bool: closed = f_close(file);
    if (!write_ok || !closed)
        println("File writing failed.");
    else if (overrun)
        println("Capture stopped: FPGA FIFO full.");
    else if (!capture_ok)
        println("Capture stopped: invalid FPGA data count.");
    else
        println(strjoin("Wrote a total of ", str(samples), " samples."));
    return write_ok && closed && capture_ok && !overrun;
}

main()
{
    if (!fpga_initialize())
        return;
    
    println("FPGA configured successfully.");
    println("Ready to capture 4 channels at 72 MSps.");
    
    // Test signal, 100 kHz.
    waveout_digital(100000);
    
    get_keys(ANY_KEY);
        
    while (!get_keys(BUTTON4))
    {
        get_keys(ANY_KEY); // Clear key buffer
        draw_menubar("Start", "", "", "Exit");

        while (!peek_keys(ANY_KEY))
        {
            delay_ms(100);
        }
        
        if (get_keys(BUTTON1))
        {
            draw_menubar("Stop", "", "", "Exit");
            do_capture();
        }
    }
}

